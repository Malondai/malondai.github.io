---
import data from "../data/portfolio.json";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import About from "../components/About.astro";
import "../styles/global.css";

const { profile, services, process, experiences, projects } = data;
---

<Layout>
    <!-- Subtle Paper Texture Overlay -->
    <div
        class="fixed inset-0 pointer-events-none z-[9999] opacity-[0.025] mix-blend-multiply bg-[url('/noise.svg')]"
        aria-hidden="true"
    ></div>

    <!-- Main Editorial Poster Container -->
    <div class="min-h-screen py-0 lg:py-8 px-0 lg:px-6">
        <div
            class="max-w-[1160px] mx-auto bg-[#F4EFE6] shadow-[0_25px_70px_rgba(25,20,12,0.16)] border-0 lg:border border-[#CFC6B8] grid grid-cols-1 lg:grid-cols-[62px_1fr] relative overflow-hidden"
        >
            <!-- LEFT VERTICAL EDITORIAL SIDEBAR (Desktop) -->
            <aside
                class="hidden lg:flex lg:flex-col border-r border-[#CFC6B8] select-none"
                aria-label="Editorial Sidebar"
            >
                <!-- Top Cream Half: Starburst + CRAFTING DIGITAL EXPERIENCES -->
                <div
                    class="bg-[#F4EFE6] text-[#0A3C9F] flex flex-col items-center justify-between py-7 h-[430px] shrink-0"
                >
                    <!-- 16-Ray Geometric Starburst Icon -->
                    <div class="w-8 h-8 flex items-center justify-center">
                        <svg viewBox="0 0 40 40" class="w-7 h-7 text-[#0A3C9F]" fill="none" stroke="currentColor" stroke-width="1.1">
                            <line x1="20" y1="2" x2="20" y2="38" />
                            <line x1="2" y1="20" x2="38" y2="20" />
                            <line x1="7.3" y1="7.3" x2="32.7" y2="32.7" />
                            <line x1="32.7" y1="7.3" x2="7.3" y2="32.7" />
                            <line x1="13.1" y1="3.4" x2="26.9" y2="36.6" />
                            <line x1="3.4" y1="13.1" x2="36.6" y2="26.9" />
                            <line x1="3.4" y1="26.9" x2="36.6" y2="13.1" />
                            <line x1="13.1" y1="36.6" x2="26.9" y2="3.4" />
                            <circle cx="20" cy="20" r="3.5" fill="#F4EFE6" stroke="currentColor" stroke-width="1.1" />
                        </svg>
                    </div>

                    <!-- Vertical Text: CRAFTING DIGITAL EXPERIENCES -->
                    <div class="my-auto">
                        <span
                            class="vertical-text text-[10.5px] font-medium tracking-[0.26em] text-[#0A3C9F] uppercase whitespace-nowrap"
                        >
                            {profile.sidebarTop || "CRAFTING DIGITAL EXPERIENCES"}
                        </span>
                    </div>
                </div>

                <!-- Bottom Royal Blue Half: Location + Availability + Globe + Barcode -->
                <div
                    class="bg-[#0A3C9F] text-[#F4EFE6] flex-1 flex flex-col items-center justify-between py-8"
                >
                    <!-- Top White Vertical Tick Line -->
                    <div class="w-[1.5px] h-9 bg-white/75"></div>

                    <!-- Vertical Text 1: BASED IN MAKASSAR, WORKING WORLDWIDE -->
                    <div class="my-6">
                        <span
                            class="vertical-text text-[10px] font-medium tracking-[0.24em] text-white/90 uppercase whitespace-nowrap"
                        >
                            {profile.sidebarLocation || "BASED IN MAKASSAR, WORKING WORLDWIDE"}
                        </span>
                    </div>

                    <!-- Vertical Text 2: AVAILABLE FOR FREELANCE & FULL-TIME -->
                    <div class="my-6">
                        <span
                            class="vertical-text text-[10px] font-medium tracking-[0.24em] text-white/90 uppercase whitespace-nowrap"
                        >
                            {profile.sidebarAvailability || "AVAILABLE FOR FREELANCE & FULL-TIME"}
                        </span>
                    </div>

                    <!-- Bottom Globe & Editorial Barcode -->
                    <div class="flex flex-col items-center gap-5 mt-4">
                        <!-- Wireframe Globe Icon -->
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.3"
                            class="w-7 h-7 text-white/90"
                        >
                            <circle cx="12" cy="12" r="10" />
                            <ellipse cx="12" cy="12" rx="4.5" ry="10" />
                            <line x1="2" y1="12" x2="22" y2="12" />
                            <line x1="3.5" y1="7.5" x2="20.5" y2="7.5" />
                            <line x1="3.5" y1="16.5" x2="20.5" y2="16.5" />
                        </svg>

                        <!-- Vertical Editorial Barcode SVG -->
                        <svg
                            viewBox="0 0 28 60"
                            class="w-7 h-14 text-white/80"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <rect x="0" y="0" width="28" height="2" />
                            <rect x="0" y="4" width="28" height="1" />
                            <rect x="0" y="7" width="28" height="2.5" />
                            <rect x="0" y="12" width="28" height="1" />
                            <rect x="0" y="15" width="28" height="1.5" />
                            <rect x="0" y="19" width="28" height="3" />
                            <rect x="0" y="24" width="28" height="1" />
                            <rect x="0" y="27" width="28" height="2" />
                            <rect x="0" y="31" width="28" height="1" />
                            <rect x="0" y="34" width="28" height="2.5" />
                            <rect x="0" y="39" width="28" height="1" />
                            <rect x="0" y="42" width="28" height="1.5" />
                            <rect x="0" y="46" width="28" height="2" />
                            <rect x="0" y="50" width="28" height="1" />
                            <rect x="0" y="53" width="28" height="3" />
                            <rect x="0" y="58" width="28" height="1.5" />
                        </svg>
                    </div>
                </div>
            </aside>

            <!-- RIGHT MAIN EDITORIAL CONTENT COLUMN -->
            <main id="content" class="flex flex-col min-w-0">
                <Header profile={profile} />

                <!-- Mobile Editorial Info Ribbon (Preserves Desktop Royal Blue Sidebar Info on Mobile) -->
                <div class="lg:hidden bg-[#0A3C9F] text-[#F4EFE6] px-5 sm:px-10 py-2.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5 text-[9.5px] sm:text-[10.5px] font-medium tracking-[0.14em] uppercase">
                    <span class="inline-flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-3.5 h-3.5 text-white/85 shrink-0">
                            <circle cx="12" cy="12" r="10" />
                            <ellipse cx="12" cy="12" rx="4.5" ry="10" />
                            <line x1="2" y1="12" x2="22" y2="12" />
                        </svg>
                        <span>{profile.sidebarLocation || "BASED IN MAKASSAR, WORKING WORLDWIDE"}</span>
                    </span>
                    <span class="text-[#D4C3B0] font-semibold">
                        {profile.sidebarAvailability || "AVAILABLE FOR FREELANCE & FULL-TIME"}
                    </span>
                </div>

                <Projects projects={projects} />
                <Experience
                    services={services}
                    process={process}
                    experiences={experiences}
                />
                <About profile={profile} />
            </main>
        </div>
    </div>

    <!-- PROJECT INSPECT MODAL (Editorial Mockup Preview with Smooth Transition) -->
    <div
        id="project-modal"
        class="editorial-modal fixed inset-0 z-[10000] bg-[#071D49]/80 backdrop-blur-xs items-center justify-center p-3 sm:p-6"
        data-open="false"
        role="dialog"
        aria-modal="true"
        aria-hidden="true"
        aria-labelledby="modal-project-title"
    >
        <div
            class="editorial-modal-panel bg-[#F4EFE6] border border-[#CFC6B8] rounded-xl max-w-4xl w-full overflow-hidden shadow-2xl flex flex-col max-h-[92vh]"
        >
            <!-- Modal Header -->
            <div class="flex items-center justify-between gap-3 px-4 sm:px-6 py-3.5 sm:py-4 border-b border-[#CFC6B8] bg-[#EFE8DC]">
                <div class="min-w-0">
                    <span
                        id="modal-project-category"
                        class="text-[9.5px] sm:text-[10px] font-bold tracking-[0.14em] sm:tracking-[0.16em] text-[#0A3C9F] uppercase block truncate"
                    ></span>
                    <h3
                        id="modal-project-title"
                        class="text-base sm:text-lg font-extrabold tracking-[0.05em] text-[#0A3C9F] uppercase truncate"
                    ></h3>
                </div>
                <button
                    type="button"
                    id="close-project-modal"
                    class="text-[#0A3C9F] hover:text-[#072D7A] hover:rotate-90 transition-all duration-300 p-1.5 cursor-pointer shrink-0"
                    aria-label="Close modal"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="overflow-y-auto p-4 sm:p-6 space-y-4 sm:space-y-5">
                <div class="rounded-lg overflow-hidden bg-[#C7B6A2] border border-[#CFC6B8] max-h-[45vh] sm:max-h-[55vh] flex items-center justify-center">
                    <img
                        id="modal-project-image"
                        src=""
                        alt=""
                        class="modal-image-reveal max-h-[45vh] sm:max-h-[55vh] w-auto object-contain"
                    />
                </div>

                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                    <div class="space-y-3 flex-1">
                        <p id="modal-project-desc" class="text-xs sm:text-sm text-[#2A2E35] leading-relaxed"></p>
                        <div id="modal-project-tags" class="flex flex-wrap gap-1.5 pt-1"></div>
                    </div>

                    <a
                        id="modal-project-link"
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hidden w-full sm:w-auto items-center justify-center gap-2 bg-[#0A3C9F] text-[#F4EFE6] text-xs font-bold tracking-[0.12em] uppercase px-5 py-3 rounded-lg hover:bg-[#072D7A] transition-colors shrink-0"
                    >
                        <span>Visit Live Project</span>
                        <span>↗</span>
                    </a>

                    <div
                        id="modal-project-no-demo"
                        class="hidden w-full sm:w-auto items-start gap-2.5 bg-[#EFE8DC] border border-[#CFC6B8] text-[#3A3F47] px-4 py-3 rounded-lg sm:max-w-[260px] shrink-0"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#0A3C9F] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        <div>
                            <span class="block text-[10px] font-extrabold tracking-[0.12em] uppercase text-[#0A3C9F]">
                                No Public Live Demo
                            </span>
                            <p id="modal-project-demo-note" class="text-[11px] leading-snug text-[#3A3F47] mt-0.5">
                                Private / internal deployment. Preview screenshots only.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BIO & FULL STORY MODAL -->
    <div
        id="bio-modal"
        class="editorial-modal fixed inset-0 z-[10000] bg-[#071D49]/80 backdrop-blur-xs items-center justify-center p-3 sm:p-6"
        data-open="false"
        role="dialog"
        aria-modal="true"
        aria-hidden="true"
    >
        <div class="editorial-modal-panel bg-[#F4EFE6] border border-[#CFC6B8] rounded-xl max-w-xl w-full p-5 sm:p-8 shadow-2xl relative max-h-[90vh] overflow-y-auto">
            <button
                type="button"
                id="close-bio-modal"
                class="absolute top-4 right-4 sm:top-5 sm:right-5 text-[#0A3C9F] hover:text-[#072D7A] hover:rotate-90 transition-all duration-300 p-1 cursor-pointer"
                aria-label="Close story modal"
            >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            <span class="text-[10.5px] sm:text-[11px] font-bold tracking-[0.18em] sm:tracking-[0.2em] text-[#0A3C9F] uppercase">
                ABOUT MUHAMMAD MAHATIR
            </span>
            <h3 class="font-serif text-2xl sm:text-3xl text-[#0A3C9F] mt-1 mb-3.5 sm:mb-4 pr-6">
                Bridging Technical Logic &amp; Real-World Impact
            </h3>
            <p class="text-xs sm:text-[15px] text-[#2A2E35] leading-relaxed">
                {profile.bio}
            </p>
            <div class="mt-5 sm:mt-6 pt-4 border-t border-[#CFC6B8] flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
                <span class="text-xs text-[#3A3F47] font-medium">
                    Makassar, Indonesia · 10+ Years Building Software
                </span>
                <a
                    href="/resume.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold tracking-[0.12em] uppercase text-[#0A3C9F] hover:underline"
                >
                    Download Full Résumé ↗
                </a>
            </div>
        </div>
    </div>

    <script>
        // 1. Toggle All Projects Archive (Smooth Drawer Expand/Collapse + Staggered Card Reveal)
        const toggleProjectsBtn = document.getElementById("toggle-all-projects");
        const archiveSection = document.getElementById("all-projects-archive");
        const toggleLabel = document.getElementById("toggle-projects-label");
        const toggleArrow = document.getElementById("toggle-projects-arrow");

        toggleProjectsBtn?.addEventListener("click", () => {
            if (!archiveSection) return;
            const isOpen = archiveSection.getAttribute("data-open") === "true";

            if (!isOpen) {
                // Re-trigger staggered entrance animation cleanly each time archive opens
                archiveSection.querySelectorAll(".archive-card-item").forEach((card) => {
                    const el = card as HTMLElement;
                    el.style.animation = "none";
                    void el.getBoundingClientRect();
                    el.style.animation = "";
                });

                archiveSection.setAttribute("data-open", "true");
                archiveSection.setAttribute("aria-hidden", "false");
                toggleProjectsBtn.setAttribute("aria-expanded", "true");
                if (toggleLabel) toggleLabel.textContent = "SHOW FEATURED ONLY";
                if (toggleArrow) toggleArrow.style.transform = "rotate(-90deg)";
            } else {
                archiveSection.setAttribute("data-open", "false");
                archiveSection.setAttribute("aria-hidden", "true");
                toggleProjectsBtn.setAttribute("aria-expanded", "false");
                if (toggleLabel) toggleLabel.textContent = "VIEW ALL PROJECTS";
                if (toggleArrow) toggleArrow.style.transform = "rotate(0deg)";
            }
        });

        // 2. Toggle MY PROCESS vs WORK EXPERIENCE
        const tabProcess = document.getElementById("tab-process");
        const tabExperience = document.getElementById("tab-experience");
        const panelProcess = document.getElementById("panel-process");
        const panelExperience = document.getElementById("panel-experience");

        tabProcess?.addEventListener("click", () => {
            panelProcess?.classList.remove("hidden");
            panelExperience?.classList.add("hidden");
            tabProcess.classList.add("border-[#0A3C9F]", "text-[#0A3C9F]", "font-extrabold");
            tabProcess.classList.remove("border-transparent", "text-[#0A3C9F]/55");
            tabExperience?.classList.remove("border-[#0A3C9F]", "text-[#0A3C9F]", "font-extrabold");
            tabExperience?.classList.add("border-transparent", "text-[#0A3C9F]/55");
        });

        tabExperience?.addEventListener("click", () => {
            panelExperience?.classList.remove("hidden");
            panelProcess?.classList.add("hidden");
            tabExperience.classList.add("border-[#0A3C9F]", "text-[#0A3C9F]", "font-extrabold");
            tabExperience.classList.remove("border-transparent", "text-[#0A3C9F]/55");
            tabProcess?.classList.remove("border-[#0A3C9F]", "text-[#0A3C9F]", "font-extrabold");
            tabProcess?.classList.add("border-transparent", "text-[#0A3C9F]/55");
            playExperienceEntrance();
        });

        // 2b. Interactive Experience Timeline Accordion + Entrance & Rail Animations
        const expItems = document.querySelectorAll(".exp-accordion-item");
        const expTimelineList = document.getElementById("exp-timeline-list");
        const expRailBase = document.getElementById("exp-rail-base");
        const expRailActive = document.getElementById("exp-rail-active");
        const expStatValues = document.querySelectorAll(".exp-stat-value");

        const updateActiveRailToItem = (targetItem: Element | null) => {
            if (!expRailActive || !expTimelineList) return;
            if (!targetItem) {
                expRailActive.style.height = "0px";
                expRailActive.classList.add("opacity-0");
                return;
            }
            const listRect = expTimelineList.getBoundingClientRect();
            const itemRect = targetItem.getBoundingClientRect();
            // Align bottom of active blue rail with the center of the item's numbered node (top + 25px)
            const targetHeight = Math.max(12, itemRect.top - listRect.top + 10);
            expRailActive.style.height = `${targetHeight}px`;
            expRailActive.classList.remove("opacity-0");
        };

        const animateCareerStats = () => {
            const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            expStatValues.forEach((el) => {
                const statEl = el as HTMLElement;
                const target = Number(statEl.dataset.target || "0");
                const suffix = statEl.dataset.suffix || "";
                const pad = Number(statEl.dataset.pad || "0");
                const formatVal = (n: number) =>
                    (pad > 0 ? String(n).padStart(pad, "0") : String(n)) + suffix;

                if (reduced) {
                    statEl.textContent = formatVal(target);
                    return;
                }

                const duration = 650;
                const start = performance.now();
                const tick = (now: number) => {
                    const progress = Math.min(1, (now - start) / duration);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    const current = Math.max(1, Math.round(eased * target));
                    statEl.textContent = formatVal(current);
                    if (progress < 1) {
                        requestAnimationFrame(tick);
                    } else {
                        statEl.textContent = formatVal(target);
                    }
                };
                requestAnimationFrame(tick);
            });
        };

        const playExperienceEntrance = () => {
            animateCareerStats();

            if (expRailBase) {
                expRailBase.classList.remove("is-animating");
                void expRailBase.getBoundingClientRect();
                expRailBase.classList.add("is-animating");
            }

            expItems.forEach((item) => {
                item.classList.remove("exp-card-animate");
                void (item as HTMLElement).getBoundingClientRect();
                item.classList.add("exp-card-animate");
            });

            // Sync blue rail to currently open item (or hide when all collapsed)
            const openItem = document.querySelector('.exp-accordion-item[data-open="true"]');
            requestAnimationFrame(() => updateActiveRailToItem(openItem));
        };

        expItems.forEach((item) => {
            const trigger = item.querySelector(".exp-accordion-trigger");

            item.addEventListener("mouseenter", () => {
                updateActiveRailToItem(item);
            });

            trigger?.addEventListener("click", () => {
                const isAlreadyOpen = item.getAttribute("data-open") === "true";

                // Close all items first (clean single-open editorial behavior)
                expItems.forEach((el) => {
                    el.setAttribute("data-open", "false");
                    el.classList.remove("bg-[#EFE8DC]/85", "border-[#0A3C9F]/30", "shadow-[0_2px_10px_rgba(10,60,159,0.05)]");
                    el.classList.add("bg-[#F4EFE6]", "border-[#CFC6B8]/80");
                    const btn = el.querySelector(".exp-accordion-trigger");
                    btn?.setAttribute("aria-expanded", "false");
                    const node = el.querySelector(".exp-node");
                    node?.classList.remove("bg-[#0A3C9F]", "text-[#F4EFE6]");
                    node?.classList.add("bg-[#F4EFE6]", "text-[#0A3C9F]", "border", "border-[#0A3C9F]/45");
                });

                // Open clicked item if it wasn't already open
                if (!isAlreadyOpen) {
                    item.setAttribute("data-open", "true");
                    item.classList.remove("bg-[#F4EFE6]", "border-[#CFC6B8]/80");
                    item.classList.add("bg-[#EFE8DC]/85", "border-[#0A3C9F]/30", "shadow-[0_2px_10px_rgba(10,60,159,0.05)]");
                    trigger.setAttribute("aria-expanded", "true");
                    const node = item.querySelector(".exp-node");
                    node?.classList.remove("bg-[#F4EFE6]", "text-[#0A3C9F]", "border", "border-[#0A3C9F]/45");
                    node?.classList.add("bg-[#0A3C9F]", "text-[#F4EFE6]");
                    setTimeout(() => updateActiveRailToItem(item), 120);
                } else {
                    updateActiveRailToItem(null);
                }
            });
        });

        expTimelineList?.addEventListener("mouseleave", () => {
            const openItem = document.querySelector('.exp-accordion-item[data-open="true"]');
            updateActiveRailToItem(openItem);
        });

        // 2c. Interactive My Process Synchronized Wheel & List Animation
        const processPanel = document.getElementById("panel-process");
        const processSteps = document.querySelectorAll(".process-step-item");
        const processSegments = document.querySelectorAll(".process-wheel-segment");
        const processStarburst = document.getElementById("process-starburst");
        const processProgressRing = document.getElementById("process-progress-ring");
        const processActiveLabel = document.getElementById("process-active-label");

        const processStepNames = [
            "01 · DISCOVER",
            "02 · DEFINE",
            "03 · DEVELOP",
            "04 · DELIVER",
        ];

        let activeProcessIdx = 0;
        let starburstAngle = 0;
        let processTimer: number | undefined;
        let isProcessPaused = false;
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const restartProgressRing = () => {
            if (!processProgressRing || prefersReducedMotion) return;
            processProgressRing.classList.remove("is-running");
            void processProgressRing.getBoundingClientRect();
            if (!isProcessPaused) {
                processProgressRing.classList.add("is-running");
            }
        };

        const setActiveProcessStep = (idx: number, rotateStar = true) => {
            const normalized = ((idx % 4) + 4) % 4;
            if (rotateStar && normalized !== activeProcessIdx) {
                starburstAngle += 45;
            }
            activeProcessIdx = normalized;

            processSteps.forEach((stepEl) => {
                const sIdx = Number((stepEl as HTMLElement).dataset.step);
                stepEl.setAttribute("data-active", sIdx === activeProcessIdx ? "true" : "false");
            });

            processSegments.forEach((segEl) => {
                const sIdx = Number((segEl as HTMLElement).dataset.step);
                segEl.setAttribute("data-active", sIdx === activeProcessIdx ? "true" : "false");
            });

            if (processStarburst) {
                processStarburst.style.transform = `rotate(${starburstAngle}deg)`;
            }

            if (processActiveLabel) {
                processActiveLabel.textContent = processStepNames[activeProcessIdx];
            }

            restartProgressRing();
        };

        const startProcessAutoCycle = () => {
            if (prefersReducedMotion) return;
            stopProcessAutoCycle();
            isProcessPaused = false;
            restartProgressRing();
            processTimer = window.setInterval(() => {
                if (!panelProcess?.classList.contains("hidden") && !isProcessPaused) {
                    setActiveProcessStep(activeProcessIdx + 1, true);
                }
            }, 3600);
        };

        const stopProcessAutoCycle = () => {
            if (processTimer) {
                window.clearInterval(processTimer);
                processTimer = undefined;
            }
        };

        const bindProcessInteractive = (nodeList: NodeListOf<Element>) => {
            nodeList.forEach((el) => {
                const stepIdx = Number((el as HTMLElement).dataset.step);
                el.addEventListener("mouseenter", () => {
                    isProcessPaused = true;
                    processProgressRing?.classList.remove("is-running");
                    setActiveProcessStep(stepIdx, true);
                });
                el.addEventListener("click", () => {
                    isProcessPaused = true;
                    processProgressRing?.classList.remove("is-running");
                    setActiveProcessStep(stepIdx, true);
                });
                el.addEventListener("keydown", (e) => {
                    const key = (e as KeyboardEvent).key;
                    if (key === "Enter" || key === " ") {
                        e.preventDefault();
                        isProcessPaused = true;
                        processProgressRing?.classList.remove("is-running");
                        setActiveProcessStep(stepIdx, true);
                    }
                });
            });
        };

        bindProcessInteractive(processSteps);
        bindProcessInteractive(processSegments);

        processPanel?.addEventListener("mouseleave", () => {
            if (!prefersReducedMotion) {
                isProcessPaused = false;
                startProcessAutoCycle();
            }
        });

        startProcessAutoCycle();

        // 3. Project Details Modal
        const projectModal = document.getElementById("project-modal");
        const modalImg = document.getElementById("modal-project-image") as HTMLImageElement;
        const modalTitle = document.getElementById("modal-project-title");
        const modalCategory = document.getElementById("modal-project-category");
        const modalDesc = document.getElementById("modal-project-desc");
        const modalTags = document.getElementById("modal-project-tags");
        const modalLink = document.getElementById("modal-project-link") as HTMLAnchorElement;
        const modalNoDemo = document.getElementById("modal-project-no-demo");
        const modalDemoNote = document.getElementById("modal-project-demo-note");
        const closeProjectBtn = document.getElementById("close-project-modal");

        document.querySelectorAll(".project-card-trigger").forEach((card) => {
            card.addEventListener("click", () => {
                const el = card as HTMLElement;
                const mockupSrc = el.dataset.projectMockup || el.dataset.projectRaw || "";

                if (modalImg) modalImg.src = mockupSrc;
                if (modalTitle) modalTitle.textContent = el.dataset.projectTitle || "";
                if (modalCategory) modalCategory.textContent = el.dataset.projectCategory || "";
                if (modalDesc) modalDesc.textContent = el.dataset.projectDesc || "";

                if (modalTags) {
                    modalTags.innerHTML = "";
                    const tags = (el.dataset.projectTags || "").split(",").filter(Boolean);
                    tags.forEach((t, idx) => {
                        const badge = document.createElement("span");
                        badge.className = "modal-tag-animate text-[10px] font-bold tracking-wider uppercase px-2.5 py-1 rounded bg-[#0A3C9F]/10 text-[#0A3C9F]";
                        badge.style.animationDelay = `${100 + idx * 35}ms`;
                        badge.textContent = t;
                        modalTags.appendChild(badge);
                    });
                }

                const url = (el.dataset.projectUrl || "").trim();
                const hasLiveDemo = Boolean(url && url !== "#");

                if (modalLink && modalNoDemo) {
                    if (hasLiveDemo) {
                        modalLink.href = url;
                        modalLink.classList.remove("hidden");
                        modalLink.classList.add("inline-flex");
                        modalNoDemo.classList.add("hidden");
                        modalNoDemo.classList.remove("flex");
                    } else {
                        modalLink.removeAttribute("href");
                        modalLink.classList.add("hidden");
                        modalLink.classList.remove("inline-flex");
                        modalNoDemo.classList.remove("hidden");
                        modalNoDemo.classList.add("flex");
                        if (modalDemoNote) {
                            modalDemoNote.textContent =
                                el.dataset.projectDemoNote ||
                                "Private / internal deployment — public live demo is unavailable.";
                        }
                    }
                }

                projectModal?.setAttribute("data-open", "true");
                projectModal?.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";
            });
        });

        const closeProjectModal = () => {
            if (projectModal?.getAttribute("data-open") !== "true") return;
            projectModal.setAttribute("data-open", "false");
            projectModal.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
        };

        closeProjectBtn?.addEventListener("click", closeProjectModal);
        projectModal?.addEventListener("click", (e) => {
            if (e.target === projectModal) closeProjectModal();
        });

        // 4. Full Bio Modal
        const bioModal = document.getElementById("bio-modal");
        const openBioBtn = document.getElementById("open-bio-modal");
        const closeBioBtn = document.getElementById("close-bio-modal");

        const closeBioModal = () => {
            if (bioModal?.getAttribute("data-open") !== "true") return;
            bioModal.setAttribute("data-open", "false");
            bioModal.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
        };

        openBioBtn?.addEventListener("click", () => {
            bioModal?.setAttribute("data-open", "true");
            bioModal?.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
        });
        closeBioBtn?.addEventListener("click", closeBioModal);
        bioModal?.addEventListener("click", (e) => {
            if (e.target === bioModal) closeBioModal();
        });

        window.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                closeProjectModal();
                closeBioModal();
            }
        });
    </script>
</Layout>
