---
interface Project {
    title: string;
    category?: string;
    shortDesc?: string;
    desc: string;
    url?: string;
    demoNote?: string;
    mockup?: string;
    image?: string;
    featured?: boolean;
    tags?: string[];
}

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;
const featuredProjects = projects.slice(0, 3);
const archiveProjects = projects.slice(3);
---

<section id="projects" class="px-5 sm:px-10 lg:px-14 py-7 sm:py-10 border-b border-[#CFC6B8] bg-[#F4EFE6]">
    <!-- Section Title Row: SELECTED WORK ------- VIEW ALL PROJECTS -> -->
    <div class="flex items-center justify-between gap-2 sm:gap-4">
        <h2 class="text-xs sm:text-base md:text-[17px] font-extrabold tracking-[0.08em] text-[#0A3C9F] uppercase shrink-0">
            SELECTED WORK
        </h2>
        <div class="hidden sm:block h-px bg-[#CFC6B8] flex-1 mx-4 sm:mx-6"></div>
        <button
            type="button"
            id="toggle-all-projects"
            class="inline-flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-[13px] font-bold tracking-[0.08em] sm:tracking-[0.12em] text-[#0A3C9F] uppercase hover:text-[#072D7A] transition-colors shrink-0 cursor-pointer group py-1"
            aria-expanded="false"
        >
            <span id="toggle-projects-label">VIEW ALL PROJECTS</span>
            <span id="toggle-projects-arrow" class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
        </button>
    </div>

    <!-- Top 3 Featured Work Cards (01, 02, 03) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7 mt-6 sm:mt-7">
        {
            featuredProjects.map((p, index) => {
                const num = String(index + 1).padStart(2, "0");
                const displayImg = p.mockup || p.image;
                return (
                    <article class="group flex flex-col">
                        <!-- Thumbnail Frame -->
                        <div
                            class="relative aspect-[4/3] w-full rounded-[10px] overflow-hidden bg-[#C7B6A2] shadow-sm border border-[#CFC6B8]/70 cursor-pointer project-card-trigger"
                            data-project-title={p.title}
                            data-project-category={p.category || "SOFTWARE ENGINEERING"}
                            data-project-desc={p.desc}
                            data-project-url={p.url || "#"}
                            data-project-mockup={p.mockup || p.image}
                            data-project-raw={p.image}
                            data-project-tags={(p.tags || []).join(",")}
                        >
                            <!-- Number Label (01, 02, 03) in top-left corner -->
                            <span class="
                                absolute top-3 left-3.5 z-20
                                text-white/95 text-xs sm:text-[13px] font-medium tracking-wider
                                drop-shadow-[0_1px_3px_rgba(0,0,0,0.45)]
                            ">
                                {num}
                            </span>

                            <!-- Inspect / Live Badge (Subtly visible on mobile touch, hover-reveal on desktop) -->
                            <div class="absolute top-3 right-3 z-20 opacity-90 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-300">
                                <span class="bg-[#0A3C9F]/90 text-[#F4EFE6] text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full backdrop-blur-xs shadow">
                                    Inspect ↗
                                </span>
                            </div>

                            <img
                                src={displayImg}
                                alt={p.title}
                                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                                loading="eager"
                            />
                        </div>

                        <!-- Text Info Below Card -->
                        <div class="mt-3.5 flex-1 flex flex-col">
                            <div class="flex items-baseline justify-between gap-2">
                                <h3 class="text-sm sm:text-[15px] font-extrabold tracking-[0.05em] text-[#0A3C9F] uppercase">
                                    {p.url && p.url !== "#" ? (
                                        <a
                                            href={p.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="hover:underline underline-offset-4 inline-flex items-center gap-1"
                                        >
                                            <span>{p.title}</span>
                                        </a>
                                    ) : (
                                        <span>{p.title}</span>
                                    )}
                                </h3>
                            </div>

                            <p class="text-[11px] font-semibold tracking-[0.08em] text-[#0A3C9F]/85 uppercase mt-0.5">
                                {p.category || "WEB APPLICATION"}
                            </p>

                            <p class="text-xs sm:text-[12.5px] text-[#3A3F47] leading-[1.55] mt-1.5 line-clamp-2">
                                {p.shortDesc || p.desc}
                            </p>
                        </div>
                    </article>
                );
            })
        }
    </div>

    <!-- Expandable Archive Grid (Projects 04 - 10) with Smooth Accordion Drawer Transition -->
    <div
        id="all-projects-archive"
        class="archive-drawer"
        data-open="false"
        aria-hidden="true"
    >
        <div class="overflow-hidden">
            <div class="mt-8 pt-8 border-t border-[#CFC6B8]/80">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6">
                    <span class="text-xs font-extrabold tracking-[0.14em] text-[#0A3C9F] uppercase">
                        COMPLETED WORK ARCHIVE (04 — {String(projects.length).padStart(2, "0")})
                    </span>
                    <span class="inline-flex items-start sm:items-center gap-1.5 text-[11px] font-medium text-[#3A3F47]/90 bg-[#EFE8DC] border border-[#CFC6B8] px-3 py-1.5 sm:py-1 rounded-lg sm:rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-[#0A3C9F] shrink-0 mt-0.5 sm:mt-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        <span>Private / Internal &amp; Archived Systems — Preview screenshots only (No live demo)</span>
                    </span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-7 pb-1">
                    {
                        archiveProjects.map((p, index) => {
                            const num = String(index + 4).padStart(2, "0");
                            const displayImg = p.mockup || p.image;
                            return (
                                <article
                                    class="archive-card-item group flex flex-col"
                                    style={`animation-delay: ${index * 60}ms;`}
                                >
                                    <div
                                        class="relative aspect-[4/3] w-full rounded-[10px] overflow-hidden bg-[#C7B6A2] shadow-sm border border-[#CFC6B8]/70 cursor-pointer project-card-trigger"
                                        data-project-title={p.title}
                                        data-project-category={p.category || "SOFTWARE ENGINEERING"}
                                        data-project-desc={p.desc}
                                        data-project-url="#"
                                        data-project-demo-note={p.demoNote || "Private / Internal System — Live demo is unavailable."}
                                        data-project-mockup={p.mockup || p.image}
                                        data-project-raw={p.image}
                                        data-project-tags={(p.tags || []).join(",")}
                                    >
                                        <span class="absolute top-3 left-3.5 z-20 text-white/95 text-xs sm:text-[13px] font-medium tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,0.45)]">
                                            {num}
                                        </span>
                                        <div class="absolute top-3 right-3 z-20 opacity-90 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-300">
                                            <span class="bg-[#0A3C9F]/90 text-[#F4EFE6] text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full backdrop-blur-xs shadow">
                                                Preview ↗
                                            </span>
                                        </div>
                                        <img
                                            src={displayImg}
                                            alt={p.title}
                                            class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                                            loading="lazy"
                                        />
                                    </div>

                                    <div class="mt-3.5 flex-1 flex flex-col">
                                        <h3 class="text-sm sm:text-[15px] font-extrabold tracking-[0.05em] text-[#0A3C9F] uppercase">
                                            {p.title}
                                        </h3>
                                        <p class="text-[11px] font-semibold tracking-[0.08em] text-[#0A3C9F]/85 uppercase mt-0.5">
                                            {p.category || "APPLICATION DEVELOPMENT"}
                                        </p>
                                        <p class="text-xs sm:text-[12.5px] text-[#3A3F47] leading-[1.55] mt-1.5 line-clamp-2">
                                            {p.shortDesc || p.desc}
                                        </p>
                                        <p class="mt-2.5 inline-flex items-center gap-1.5 text-[10.5px] font-semibold tracking-[0.04em] text-[#6B5F52] uppercase">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0 text-[#0A3C9F]/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                            </svg>
                                            <span>Private / Internal · No Public Demo</span>
                                        </p>
                                    </div>
                                </article>
                            );
                        })
                    }
                </div>
            </div>
        </div>
    </div>
</section>
