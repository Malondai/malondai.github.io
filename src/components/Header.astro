---
interface Props {
  profile: {
    name: string;
    shortName?: string;
    brandSub?: string;
    monogram?: string;
    avatar: string;
    avatarFallback?: string;
    role: string;
    shortBio?: string;
    bio: string;
  };
}

const { profile } = Astro.props;
---

<header class="relative overflow-hidden border-b border-[#CFC6B8] bg-[#F4EFE6]">
  <!-- Bottom-Right Vertical Ribbed / Fluted Texture Block (z-0, tucked underneath the warm sand circle) -->
  <div
    class="pointer-events-none absolute bottom-0 right-0 h-[36%] sm:h-[48%] lg:h-[66%] w-[44%] sm:w-[32%] lg:w-[27%] fluted-texture z-0 border-l border-[#DFD5C5]/70"
    aria-hidden="true"
  ></div>

  <!-- Top-Right Warm Sand Circle / Arch (z-[1] so its bottom curve overlaps the top of the fluted texture cleanly!) -->
  <div
    class="pointer-events-none absolute -top-20 -right-20 sm:-top-28 sm:-right-12 h-[230px] w-[230px] sm:h-[400px] sm:w-[400px] lg:h-[470px] lg:w-[470px] rounded-full bg-[#DFD2C0] z-[1]"
    aria-hidden="true"
  ></div>

  <!-- Role Tag in Top Right -->
  <div class="relative z-20 flex flex-wrap justify-between items-center gap-2 px-5 pt-5 sm:px-10 sm:pt-8 lg:px-14 lg:pt-9">
    <div class="lg:hidden flex items-center gap-2 text-[#0A3C9F]">
      <svg
        viewBox="0 0 32 32"
        class="w-4 h-4 sm:w-5 sm:h-5 text-[#0A3C9F] shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
      >
        <line x1="16" y1="2" x2="16" y2="30" />
        <line x1="2" y1="16" x2="30" y2="16" />
        <line x1="6" y1="6" x2="26" y2="26" />
        <line x1="26" y1="6" x2="6" y2="26" />
        <circle
          cx="16"
          cy="16"
          r="3.5"
          fill="#F4EFE6"
          stroke="currentColor"
          stroke-width="1.4"
        />
      </svg>
      <span class="text-[9px] sm:text-[10px] font-semibold tracking-[0.14em] sm:tracking-[0.22em] uppercase">
        CRAFTING DIGITAL EXPERIENCES
      </span>
    </div>
    <div class="ml-auto text-right">
      <span class="text-[10.5px] sm:text-sm md:text-[15px] font-medium tracking-[0.16em] sm:tracking-[0.22em] text-[#0A3C9F] uppercase">
        {profile.role}
      </span>
    </div>
  </div>

  <!-- Main Hero Grid -->
  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 items-end px-5 sm:px-10 lg:px-14 pt-3 sm:pt-4">
    <!-- Left Column: Stacked PORTFOLIO Title + Bio + Signature -->
    <div class="lg:col-span-5 pb-4 sm:pb-8 lg:pb-12 pt-1 sm:pt-2 relative z-20">
      <h1 class="font-display text-[#0A3C9F] uppercase select-none leading-[0.86] tracking-[-0.01em] text-[4.75rem] sm:text-[7.75rem] md:text-[9rem] xl:text-[10.25rem]">
        <span class="block">PORT</span>
        <span class="block mt-1">FOLIO</span>
      </h1>

      <!-- Short Blue Accent Line + Full Name Editorial Label -->
      <div class="flex items-center gap-3 sm:gap-3.5 mt-5 sm:mt-6 mb-4 sm:mb-5">
        <div class="w-8 sm:w-10 h-[2.5px] bg-[#0A3C9F] shrink-0"></div>
        <p class="text-[13px] sm:text-[15px] md:text-base font-extrabold tracking-[0.12em] sm:tracking-[0.14em] text-[#0A3C9F] uppercase">
          {profile.name}
        </p>
      </div>

      <!-- Concise Editorial Bio + Full Bio Trigger -->
      <div class="max-w-full sm:max-w-[350px] space-y-2.5">
        <p class="text-[#2A2E35] text-sm sm:text-[15.5px] leading-[1.6] font-normal">
          I engineer digital experiences that are functional, scalable and
          human-centered.
        </p>
        <p class="text-[#2A2E35] text-sm sm:text-[15.5px] leading-[1.6] font-normal">
          Specialized in{" "}
          <strong class="font-semibold text-[#0A3C9F]">
            Full-Stack Web &amp; SaaS
          </strong>{" "}
          architecture for web and mobile.
        </p>
        <button
          type="button"
          id="open-bio-modal"
          class="inline-flex items-center gap-1.5 text-[11px] font-bold tracking-[0.14em] uppercase text-[#0A3C9F] hover:text-[#072D7A] pt-1 cursor-pointer group"
        >
          <span>Read Full Story (2016–2026)</span>
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </button>
      </div>

      <!-- Handwritten Signature (Matches reference poster calligraphic flourish) -->
      <div class="mt-4 sm:mt-5 text-[#0A3C9F]" aria-label={`${profile.name} signature`}>
        <svg
          viewBox="0 0 210 48"
          class="w-32 sm:w-44 h-auto text-[#0A3C9F]"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M10 36C15 23 23 11 27 11C31 11 23 33 26 34C29 35 39 16 43 16C46 16 39 33 43 34C48 35 58 21 63 22C67 23 61 32 66 32C72 32 82 22 89 23C95 24 89 31 98 30C108 29 124 26 146 25C165 24 185 24 198 23"
            stroke="currentColor"
            stroke-width="1.65"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M114 17C119 17 126 16 132 16"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
          />
        </svg>
      </div>
    </div>

    <!-- Right Column: Polished Editorial Portrait + Monogram Seal -->
    <div class="lg:col-span-7 relative flex items-end justify-start sm:justify-center lg:justify-start min-h-[290px] sm:min-h-[440px] lg:min-h-[530px] pt-2 lg:pt-0">
      <!-- Portrait Wrapper: Aligned slightly left on mobile so right fluted column stays open for MM monogram -->
      <div class="relative z-10 w-[76%] max-w-[300px] sm:max-w-none sm:w-[410px] md:w-[460px] lg:w-[495px] xl:w-[515px] -ml-3 sm:-ml-16 lg:-ml-12 xl:-ml-10 flex items-end">
        <img
          src="/athir-hero-v2.png"
          alt={profile.name}
          class="w-full h-auto object-contain object-bottom block select-none"
          loading="eager"
        />
      </div>

      <!-- Right Monogram Badge (Cleanly placed in right fluted zone across mobile & desktop without overlapping portrait) -->
      <div class="absolute right-0 sm:right-4 lg:right-1 xl:right-2 bottom-16 sm:bottom-28 lg:bottom-36 z-20 flex flex-col items-center text-center">
        <div class="w-14 h-14 sm:w-[82px] sm:h-[82px] rounded-full bg-[#0A3C9F] text-[#F4EFE6] flex items-center justify-center shadow-sm border border-[#0A3C9F]/10">
          <span class="font-serif text-[22px] sm:text-[34px] tracking-tighter leading-none font-normal italic pr-0.5">
            M<span class="-ml-1 not-italic">M</span>
          </span>
        </div>
        <div class="mt-2 sm:mt-3 text-[#0A3C9F] uppercase text-center leading-tight">
          <span class="block text-xs sm:text-[15px] md:text-base font-extrabold tracking-[0.12em] sm:tracking-[0.15em]">
            {profile.shortName || "M. MAHATIR"}
          </span>
          <span class="block text-[9.5px] sm:text-xs font-semibold tracking-[0.18em] sm:tracking-[0.22em] text-[#0A3C9F]/85 mt-0.5 sm:mt-1">
            {profile.brandSub || "SOFTWARE"}
          </span>
        </div>
      </div>
    </div>
  </div>
</header>
