---
interface Props {
    profile: {
        name: string;
        email?: string;
        website?: string;
        location?: string;
        phone?: string;
        socials: {
            github: string;
            linkedin: string;
            instagram: string;
        };
    };
}

const { profile } = Astro.props;
---

<footer class="bg-[#0A3C9F] text-[#F4EFE6] px-5 sm:px-10 lg:px-14 py-8 sm:py-11 relative overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 items-center gap-7 lg:gap-8">
        <!-- Left Column: LET'S CREATE SOMETHING GREAT + Contact Details + Social Icons -->
        <div class="lg:col-span-5 pb-7 border-b border-white/20 lg:pb-0 lg:border-b-0 lg:border-r lg:pr-8">
            <h2 class="text-base sm:text-lg md:text-[19px] font-bold tracking-[0.08em] text-white uppercase leading-[1.3]">
                <span class="block">LET'S CREATE</span>
                <span class="block">SOMETHING GREAT</span>
            </h2>

            <p class="text-xs text-white/80 leading-relaxed mt-2.5 max-w-[270px]">
                I'm always open to new opportunities and exciting collaborations.
            </p>

            <!-- Contact Info List -->
            <ul class="mt-4 space-y-2 text-xs text-white/95">
                <li class="flex items-center gap-2.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-white/80 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="16" x="2" y="4" rx="2" />
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                    <a href={`mailto:${profile.email || "atir417@gmail.com"}`} class="hover:underline">
                        {profile.email || "atir417@gmail.com"}
                    </a>
                </li>
                <li class="flex items-center gap-2.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-white/80 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                        <path d="M2 12h20" />
                    </svg>
                    <a href={`https://${profile.website || "malondai.github.io"}`} target="_blank" rel="noopener noreferrer" class="hover:underline">
                        {profile.website || "malondai.github.io"}
                    </a>
                </li>
                <li class="flex items-center gap-2.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-white/80 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                        <circle cx="12" cy="10" r="3" />
                    </svg>
                    <span>{profile.location || "Makassar, Indonesia"}</span>
                </li>
            </ul>

            <!-- Social Links Row -->
            <div class="mt-5 flex items-center gap-4">
                <a
                    href={profile.socials.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="GitHub"
                    class="text-white/90 hover:text-[#D4C3B0] transition-colors"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                    </svg>
                </a>
                <a
                    href={profile.socials.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="LinkedIn"
                    class="text-white/90 hover:text-[#D4C3B0] transition-colors"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.238 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                </a>
                <a
                    href={profile.socials.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Instagram"
                    class="text-white/90 hover:text-[#D4C3B0] transition-colors"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                    </svg>
                </a>
            </div>
        </div>

        <!-- Right Column: Handwritten "Let's Collaborate" + Circular "OPEN TO NEW PROJECTS" Stamp -->
        <div class="lg:col-span-7 relative flex items-center justify-between gap-2 min-h-[125px] sm:min-h-[190px]">
            <!-- Expressive Calligraphic Script "Let's Collaborate" -->
            <a
                href={`mailto:${profile.email || "atir417@gmail.com"}`}
                class="group relative block select-none pr-2 sm:pr-14 lg:pr-20 min-w-0"
                aria-label="Let's Collaborate - Send an Email"
            >
                <div class="font-script text-[#D9C7B2] group-hover:text-white transition-colors">
                    <span class="block text-4xl sm:text-6xl md:text-7xl leading-none -rotate-6 origin-bottom-left ml-2 sm:ml-6">
                        Let's
                    </span>
                    <span class="block text-[2.85rem] sm:text-7xl md:text-[5.5rem] leading-[0.9] -rotate-6 origin-bottom-left mt-1 sm:mt-2 relative">
                        Collaborate
                    </span>
                </div>
                <!-- Extended Calligraphic Crossbar Swash reaching toward the badge -->
                <svg
                    viewBox="0 0 320 50"
                    class="w-36 sm:w-64 md:w-72 h-auto text-[#D9C7B2] group-hover:text-white transition-colors -mt-6 sm:-mt-12 ml-12 sm:ml-36 pointer-events-none"
                    fill="none"
                >
                    <path
                        d="M5 38 C 75 24, 185 12, 310 6"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                    />
                </svg>
            </a>

            <!-- Circular "OPEN TO NEW PROJECTS" Stamp Badge (Top-Right of Footer) -->
            <div class="w-20 h-20 sm:w-28 sm:h-28 shrink-0 relative flex items-center justify-center">
                <svg viewBox="0 0 120 120" class="w-full h-full">
                    <defs>
                        <path
                            id="openProjectsCircle"
                            d="M 60, 60 m -42, 0 a 42,42 0 1,1 84,0 a 42,42 0 1,1 -84,0"
                        />
                    </defs>
                    <text
                        fill="#D9C7B2"
                        font-size="8.5"
                        font-weight="600"
                        letter-spacing="2.7"
                        class="uppercase"
                    >
                        <textPath href="#openProjectsCircle" startOffset="5%">
                            OPEN TO NEW PROJECTS •
                        </textPath>
                    </text>
                    <!-- Center 8-Point Starburst -->
                    <g stroke="#D9C7B2" stroke-width="1.2" stroke-linecap="round">
                        <line x1="60" y1="45" x2="60" y2="75" />
                        <line x1="45" y1="60" x2="75" y2="60" />
                        <line x1="50" y1="50" x2="70" y2="70" />
                        <line x1="70" y1="50" x2="50" y2="70" />
                    </g>
                </svg>
            </div>
        </div>
    </div>
</footer>
